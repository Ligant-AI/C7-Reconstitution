# Response headers for the Pages project. The page also carries a meta CSP, but
# frame-ancestors cannot be delivered from a meta element, so the policy has to
# be sent here as well.
#
# Everything is 'self' (C7-NF-12, §14.1 claim 3). Unlike C3 1.0.1 there is NO
# allowance for static.cloudflareinsights.com: the verbatim privacy statement
# says no analytics scripts and no third-party code of any kind run on this
# page. Edge-injected scripts (Web Analytics auto-injection, Rocket Loader,
# email obfuscation) must also be confirmed OFF for this path in the zone
# configuration — the CSP would block them, but acceptance 17 requires that
# they are not injected, not merely that they fail.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()

# index.html must not outlive a deploy; the hashed assets can be cached hard.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Served without an extension, so the type has to be stated or it downloads
# instead of displaying. The footer links to it.
/LICENSE
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
